# ---------------------------------------------------------------------------
# NOORLUME - environment variables
# Copy to .env.local for local development. Set the same keys in Vercel
# (Project > Settings > Environment Variables) for production.
# Keys starting with NEXT_PUBLIC_ are sent to the browser. Everything else
# stays on the server. Never put a secret in a NEXT_PUBLIC_ key.
# ---------------------------------------------------------------------------

# --- Public site details (all optional; unset values show as placeholders) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Digits only, with country code, no + or spaces. Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_OFFICE_ADDRESS=
# Google Maps > Share > Embed a map > copy only the src="..." URL
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# --- Supabase (database + administrator sign-in) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to insert enquiries. Never expose this key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude API (chatbot). Server only. ---
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Resend (enquiry notification emails). Server only. ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend
ENQUIRY_FROM_EMAIL=NOORLUME Website <enquiries@yourdomain.com>
# Where notifications are delivered (comma-separated for several)
ENQUIRY_NOTIFY_EMAIL=
